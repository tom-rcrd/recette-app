PORT=8787
# Projet Supabase (Settings > API) — la clé "anon" suffit : les requêtes passent avec le jeton de l'utilisateur (RLS)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=

# Fournisseur LLM pour l'extraction : gemini | ollama | openai
LLM_PROVIDER=gemini

# Gemini (offre gratuite : https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama (local, open source) — sur un PC avec GPU de préférence, un Raspberry Pi est très lent en vision
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b

# Toute API compatible OpenAI : Groq, OpenRouter (modèles :free), Mistral, LM Studio…
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Dossier de la version web de l'app (npm run build:web) servie par le Pi
WEB_DIST=../mobile/dist
