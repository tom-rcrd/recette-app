{
  "expo": {
    "name": "Recettes",
    "slug": "recettes",
    "scheme": "recettes",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.recettes.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choisir une photo de recette à importer."
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Scanner le code-barres d'un produit ou photographier une recette."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
